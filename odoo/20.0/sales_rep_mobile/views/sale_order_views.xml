<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_view_form_inherit_rep" model="ir.ui.view">
        <field name="name">sale.order.form.sales.rep</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="sales_rep_id"/>
                <field name="rep_visit_id" invisible="not rep_visit_id"/>
            </xpath>
        </field>
    </record>

    <record id="action_rep_orders" model="ir.actions.act_window">
        <field name="name">Rep Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('sales_rep_id', '!=', False)]</field>
    </record>
</odoo>
