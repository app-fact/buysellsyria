<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sync_log_view_list" model="ir.ui.view">
        <field name="name">sales.rep.sync.log.list</field>
        <field name="model">sales.rep.sync.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" decoration-danger="state == 'error'">
                <field name="create_date"/>
                <field name="rep_id"/>
                <field name="op_type"/>
                <field name="state"/>
                <field name="res_model"/>
                <field name="res_id"/>
                <field name="message"/>
                <field name="uuid" optional="hide"/>
                <field name="payload" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="sync_log_view_search" model="ir.ui.view">
        <field name="name">sales.rep.sync.log.search</field>
        <field name="model">sales.rep.sync.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="rep_id"/>
                <field name="uuid"/>
                <filter name="errors" string="Errors" domain="[('state', '=', 'error')]"/>
            </search>
        </field>
    </record>

    <record id="action_sync_log" model="ir.actions.act_window">
        <field name="name">Sync Log</field>
        <field name="res_model">sales.rep.sync.log</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_errors': 1}</field>
    </record>
</odoo>
