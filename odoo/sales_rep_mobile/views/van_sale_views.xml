<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="van_sale_view_list" model="ir.ui.view">
        <field name="name">sales.rep.van.sale.list</field>
        <field name="model">sales.rep.van.sale</field>
        <field name="arch" type="xml">
            <list create="0" decoration-danger="sale_type == 'return'" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="date"/>
                <field name="rep_id"/>
                <field name="partner_id"/>
                <field name="sale_type"/>
                <field name="amount_total" sum="Total"/>
                <field name="amount_paid" sum="Paid"/>
                <field name="amount_due" sum="Due"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="van_sale_view_form" model="ir.ui.view">
        <field name="name">sales.rep.van.sale.form</field>
        <field name="model">sales.rep.van.sale</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_cancel" type="object" string="Cancel &amp; Return Stock"
                            invisible="state != 'done'" groups="sales_rep_mobile.group_rep_manager"
                            confirm="Goods will be put back into the van. Continue?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="rep_id"/>
                            <field name="sale_type"/>
                            <field name="visit_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="picking_id"/>
                            <field name="latitude"/>
                            <field name="longitude"/>
                            <field name="printed_count"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list>
                            <field name="product_id"/>
                            <field name="qty"/>
                            <field name="uom_id"/>
                            <field name="price_unit"/>
                            <field name="discount"/>
                            <field name="subtotal"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="amount_untaxed"/>
                        <field name="amount_discount"/>
                        <field name="amount_total" class="oe_subtotal_footer_separator"/>
                        <field name="amount_paid"/>
                        <field name="amount_due"/>
                    </group>
                    <field name="note" placeholder="Notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="van_sale_view_search" model="ir.ui.view">
        <field name="name">sales.rep.van.sale.search</field>
        <field name="model">sales.rep.van.sale</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="rep_id"/>
                <filter name="today" string="Today"
                        domain="[('date', '>=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter name="credit" string="With Due Amount" domain="[('amount_due', '>', 0)]"/>
                <filter name="returns" string="Returns" domain="[('sale_type', '=', 'return')]"/>
                <group>
                    <filter name="group_rep" string="Rep" context="{'group_by': 'rep_id'}"/>
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_date" string="Day" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="van_sale_view_pivot" model="ir.ui.view">
        <field name="name">sales.rep.van.sale.pivot</field>
        <field name="model">sales.rep.van.sale</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="rep_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="amount_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_van_sale" model="ir.actions.act_window">
        <field name="name">Van Sales</field>
        <field name="res_model">sales.rep.van.sale</field>
        <field name="view_mode">list,form,pivot</field>
    </record>
</odoo>
