<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="visit_view_list" model="ir.ui.view">
        <field name="name">sales.rep.visit.list</field>
        <field name="model">sales.rep.visit</field>
        <field name="arch" type="xml">
            <list create="0" decoration-warning="is_manual" decoration-info="state == 'open'">
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="rep_id"/>
                <field name="partner_id"/>
                <field name="duration" widget="float_time" sum="Total"/>
                <field name="result" widget="badge"/>
                <field name="is_manual"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="visit_view_form" model="ir.ui.view">
        <field name="name">sales.rep.visit.form</field>
        <field name="model">sales.rep.visit</field>
        <field name="arch" type="xml">
            <form create="0">
                <header><field name="state" widget="statusbar"/></header>
                <sheet>
                    <div class="oe_title"><h1><field name="partner_id"/></h1></div>
                    <group>
                        <group string="Check-in">
                            <field name="rep_id"/>
                            <field name="check_in"/>
                            <field name="open_mode"/>
                            <field name="in_distance"/>
                            <field name="in_latitude"/>
                            <field name="in_longitude"/>
                        </group>
                        <group string="Check-out">
                            <field name="check_out"/>
                            <field name="close_mode"/>
                            <field name="out_distance"/>
                            <field name="out_latitude"/>
                            <field name="out_longitude"/>
                            <field name="duration"/>
                        </group>
                        <group string="Result">
                            <field name="result"/>
                            <field name="no_sale_reason"/>
                            <field name="is_manual"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Van Sales"><field name="van_sale_ids"/></page>
                        <page string="Orders"><field name="order_ids"/></page>
                        <page string="Collections"><field name="collection_ids"/></page>
                        <page string="Notes"><field name="note"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="visit_view_search" model="ir.ui.view">
        <field name="name">sales.rep.visit.search</field>
        <field name="model">sales.rep.visit</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="rep_id"/>
                <filter name="today" string="Today"
                        domain="[('check_in', '>=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter name="open" string="In Progress" domain="[('state', '=', 'open')]"/>
                <filter name="manual" string="Manual (to review)" domain="[('is_manual', '=', True)]"/>
                <filter name="no_sale" string="No Sale" domain="[('result', '=', 'no_sale')]"/>
                <group>
                    <filter name="group_rep" string="Rep" context="{'group_by': 'rep_id'}"/>
                    <filter name="group_result" string="Result" context="{'group_by': 'result'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'check_in:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_visit" model="ir.actions.act_window">
        <field name="name">Visits</field>
        <field name="res_model">sales.rep.visit</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
